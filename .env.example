# Copy this file to .env, then replace every placeholder before deployment.
PORT=3000
HOST=0.0.0.0
BASE_PATH=/ai
NODE_ENV=development
DATA_DIR=./data
# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Default is same-origin ('self'); list exact trusted origins only when iframe embedding cross-origin.
# FRAME_ANCESTORS="'self' https://www.zynernova.com"

# Required before exposing the admin dashboard. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required to encrypt API keys entered in the admin panel. Use at least 32 random bytes.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Optional: configure via environment instead of the admin settings page.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
